{
  "name": "react-native-liquid-glass-kit",
  "version": "0.1.0",
  "description": "Native Android liquid glass for React Native with AGSL refraction, blur, tint, depth and interactive optics.",
  "keywords": [
    "react-native",
    "android",
    "liquid-glass",
    "glassmorphism",
    "agsl",
    "blur",
    "refraction",
    "fabric",
    "new-architecture"
  ],
  "homepage": "https://github.com/ferhadsultan98/react-native-liquid-glass-kit#readme",
  "bugs": {
    "url": "https://github.com/ferhadsultan98/react-native-liquid-glass-kit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ferhadsultan98/react-native-liquid-glass-kit.git"
  },
  "license": "MIT",
  "author": {
    "name": "Farhad Sultanov",
    "url": "https://github.com/ferhadsultan98"
  },
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./lib/commonjs/index.js",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "android",
    "src",
    "lib",
    "react-native.config.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSES",
    "THIRD_PARTY_NOTICES.md",
    "!**/__tests__",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "rimraf lib android/build",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.76.0 <1.0.0"
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/react": "^19.2.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-builder-bob": "^0.43.0",
    "rimraf": "^6.1.2",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNLiquidGlassSpec",
    "type": "components",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.liquidglasskit"
    }
  }
}
